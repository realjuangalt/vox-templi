# Copy to /etc/vox-templi/env and chmod 600.
# Never commit a filled copy.

# RPC cookie written by bitcoind (same user that runs `python -m vox_templi`).
# Examples: ~/.bitcoin/.cookie  or  /home/bitcoin/.bitcoin/.cookie
VOX_BITCOIN_COOKIE=~/.bitcoin/.cookie
VOX_RPC_URL=http://127.0.0.1:8332

# Keep loopback unless you put a reverse proxy with auth in front.
VOX_BIND=127.0.0.1
VOX_PORT=8090
VOX_POLL=8

VOX_PREFIX=/opt/vox-templi
VOX_STATE_DIR=/var/lib/vox-templi
VOX_WWW=/opt/vox-templi/www

VOX_ALSA_DEVICE=plughw:0,0
VOX_KIOSK_URL=http://127.0.0.1:8090/

# Rolling debug log (inputs/outputs). Default: shrink when over 2 MiB.
# VOX_LOG_PATH=/var/lib/vox-templi/vox.log
# VOX_LOG_MAX_BYTES=2097152
# VOX_LOG_FOREVER=0
# Optional HDMI (wlr-randr):
# VOX_OUTPUT=HDMI-A-1
# VOX_MODE=1280x720
