[Unit]
Description=Embassy HDMI kiosk (cage + chromium, lean)
After=embassy-monitor.service seatd.service systemd-user-sessions.service
Wants=embassy-monitor.service seatd.service
Conflicts=getty@tty1.service proofofsound-kiosk.service

[Service]
Type=simple
User=kiosk
Group=kiosk
SupplementaryGroups=seat video render input audio
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
UnsetEnvironment=TERM
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=XDG_SESSION_TYPE=wayland
Environment=EM_KIOSK_URL=http://127.0.0.1:8090/
Environment=EM_CHROMIUM_PROFILE=/var/lib/embassy-monitor/chromium
Environment=WLR_RENDERER=pixman
Environment=LIBGL_ALWAYS_SOFTWARE=1
ExecStartPre=+-/usr/bin/mkdir -p /run/user/1000 /var/lib/embassy-monitor/chromium /var/log/embassy-monitor
ExecStartPre=+-/usr/bin/chown kiosk:kiosk /run/user/1000 /var/lib/embassy-monitor/chromium /var/log/embassy-monitor
ExecStartPre=+-/usr/bin/chmod 700 /run/user/1000
ExecStart=/opt/embassy-monitor/scripts/kiosk.sh
Restart=on-failure
RestartSec=5
Nice=10
CPUWeight=40
CPUQuota=120%
MemoryMax=700M

[Install]
WantedBy=multi-user.target
