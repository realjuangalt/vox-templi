[Unit]
Description=Vox Templi UTXOracle (last 144 blocks, this node)
After=vox-templi.service

[Service]
Type=oneshot
Nice=19
CPUWeight=20
MemoryMax=400M
TimeoutStartSec=2400
EnvironmentFile=-/etc/vox-templi/env
Environment=PYTHONPATH=/opt/vox-templi
WorkingDirectory=/opt/vox-templi
ExecStart=/usr/bin/python3 -m vox_templi oracle
